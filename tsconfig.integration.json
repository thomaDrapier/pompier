{
  // Vérification des types des tests d'intégration qui importent le code de
  // l'application (tests/rls/requetes.test.ts et tests/rls/referentiel.test.ts),
  // lors de « npm run build » (tsc -b). Ils importent src/data/ (alias « @/ ») :
  // il leur faut la résolution de modules de l'application (bundler) en plus des types
  // de Node, d'où cette configuration séparée de tsconfig.tests.json.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.integration.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests/rls/requetes.test.ts", "tests/rls/referentiel.test.ts"]
}
