{
  // Vérification des types des tests exécutés dans Node (tests/rls, tests/e2e)
  // et de leurs fichiers de configuration, lors de « npm run build » (tsc -b).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests", "vitest.rls.config.ts", "playwright.config.ts"],
  // Vérifié par tsconfig.integration.json (il importe le code de src/).
  "exclude": ["tests/rls/requetes.test.ts"]
}
